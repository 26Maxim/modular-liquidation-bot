# ==============================================================================
# Modular Multi-Chain Liquidation Bot Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual keys, credentials, or secrets to source control!
# Copy this file to .env and provide your deployment-specific configuration.
# ==============================================================================

# Core Operating Mode
# Set to DRY_RUN (default) or LIVE.
# Note: LIVE mode also strictly requires ALLOW_LIVE_EXECUTION=true and runtime operator confirmation.
DEFAULT_BOT_MODE=DRY_RUN
ALLOW_LIVE_EXECUTION=false

# Environment & Server
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./data/liquidator.db
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_32_BYTE_STRING
HOST=0.0.0.0
PORT=8090

# Google OpenID Connect (OIDC) Authentication
# Obtain these from the Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8090/auth/callback

# Authentication Access Control Allowlist
# Comma-separated list of approved Google emails or subject IDs (sub).
# Empty allowlist will deny ALL logins by default!
AUTH_ALLOWLIST=operator@example.com,lead-dev@example.com
ADMIN_ALLOWLIST=admin@example.com

# For local offline testing only (disables OIDC redirect and uses mock admin user)
DEV_AUTH_BYPASS=true

# Session Parameters
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Chain RPC Endpoints
BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
APTOS_RPC_URL=https://fullnode.mainnet.aptoslabs.com/v1

# Contract Addresses (Base Mainnet Moonwell & Balancer)
MOONWELL_COMPTROLLER_ADDRESS=0xfBb21156Cc56a1745773299298379B5e7834E35A
BALANCER_VAULT_ADDRESS=0xBA12222222228d8Ba445958a75a0704d566BF2C8
UNISWAP_V3_ROUTER_ADDRESS=0x2626664c2603336E57B271c5C0b26F421741e481
UNISWAP_V3_QUOTER_ADDRESS=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a
EXECUTOR_CONTRACT_ADDRESS=

# Transaction Signer Key (DO NOT hardcode in git! Only load via secure environment)
SIGNER_PRIVATE_KEY=

# Risk Management Parameters
MAX_REPAY_USD=25000.00
MIN_PROFIT_USD=15.00
MAX_SLIPPAGE_BPS=100
MAX_GAS_GWEI=5.0
MAX_DAILY_LOSS_USD=1000.00
SIMULATION_COOLDOWN_SECONDS=60
MAX_ORACLE_STALENESS_SECONDS=300
